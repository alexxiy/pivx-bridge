# systemd unit for pivx-bridge, installed in /opt/pivx-bridge.
#
# Install:
#   sudo useradd --system --home-dir /opt/pivx-bridge --shell /usr/sbin/nologin pivx-bridge
#   sudo install -d -m 750 -o pivx-bridge -g pivx-bridge /opt/pivx-bridge
#   sudo install -m 755 target/release/pivx-bridge /opt/pivx-bridge/
#   sudo install -m 640 -g pivx-bridge .env.sample /opt/pivx-bridge/.env
#   sudo nano /opt/pivx-bridge/.env  # RPC credentials, ADDR_INDEX, ...
#   sudo install -m 644 contrib/pivx-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pivx-bridge
#
# /opt/pivx-bridge holds the binary, .env, the data files (shield.*,
# addr_index*.redb) and the log, pivx-bridge.log (rotated at 50 MB, 5 kept).
# The journal only shows a crash.
#
# To serve the Sapling parameters, set SAPLING_PARAMS_DIR in .env to a
# directory the pivx-bridge user can read: home directories are read-only
# here, and often closed to other users.
#
# Starts after pivxd.service (and starts it too). If pivxd runs under
# another unit name, change it below. The bridge also waits for the node
# itself while it's still loading.

[Unit]
Description=PIVX Bridge (shield sync and address index for light wallets)
Documentation=https://github.com/PIVX-Labs/pivx-bridge
Wants=network-online.target pivxd.service
After=network-online.target pivxd.service

[Service]
Type=exec
User=pivx-bridge
Group=pivx-bridge
WorkingDirectory=/opt/pivx-bridge
ExecStart=/opt/pivx-bridge/pivx-bridge
Restart=on-failure
# Keeps systemd from using up its restart limit within a second.
RestartSec=5
# Every block is fsynced before it's recorded, so a kill loses nothing.
TimeoutStopSec=30
# One per open connection: many wallets syncing at once.
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/pivx-bridge
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
