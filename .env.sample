# PIVX Bridge configuration
# Copy to .env and adjust as needed. Every value shown is the default;
# RPC_USER and RPC_PASS must match rpcuser/rpcpassword in pivx.conf.

RPC_URL=http://127.0.0.1:51473
RPC_USER=rpc
RPC_PASS=rpc
# The node's zmqpubhashblock (without it new blocks are found by polling)
ZMQ_URL=tcp://127.0.0.1:28332

# Port, and the IP addresses to listen on, comma-separated, IPv4 and/or
# IPv6: 127.0.0.1 behind nginx, 0.0.0.0,:: for every address
PORT=3000
# LISTEN=0.0.0.0

# Gzip of JSON answers; turn it off when nginx (or another proxy) compresses
# NO_COMPRESSION=false

# Sapling activation height (mainnet; regtest: 301)
# SAPLING_HEIGHT=2700501

# Comma-separated list of allowed RPC methods for the proxy endpoint
# ALLOWED_RPCS=getblockcount,getblockhash,getblock,getrawtransaction,sendrawtransaction,getmasternodecount,listmasternodes,relaymasternodebroadcast,getnetworkinfo,getbudgetprojection,getbudgetinfo,getbudgetvotes,mnbudgetrawvote,submitbudget

# Proxy jq filters: known (what MyPIVXWallet and PIVXie send), any, or off
# JQ_FILTERS=known

# Transparent address index: /status, /address, /xpub, /utxo, /tx, /sendtx,
# /watch. PIVXie needs it; the first run indexes the whole chain.
# ADDR_INDEX=false
# ADDR_INDEX_PATH=addr_index.redb

# Serve the Sapling proving parameters to wallets (default: $HOME/.pivx-params)
# SAPLING_PARAMS_DIR=/home/pivx/.pivx-params

# Testnet node (enables /testnet/ routes); user and password default to the
# mainnet ones, and without ZMQ testnet checks for blocks every 10 s
# TESTNET_RPC_URL=http://127.0.0.1:51475
# TESTNET_RPC_USER=rpc
# TESTNET_RPC_PASS=rpc
# TESTNET_ZMQ_URL=tcp://127.0.0.1:28333
# TESTNET_SAPLING_HEIGHT=501
# TESTNET_ADDR_INDEX_PATH=addr_index.testnet.redb
